#!/usr/bin/env php
<?php

declare(strict_types=1);

use PicoIR\Assembler\Assembler;

require __DIR__ . '/../vendor/autoload.php';

if ($argc < 3 || $argc > 4) {
    fwrite(STDERR, "Usage: armasm <input.s> <output> [--object|--elf]\n");
    exit(2);
}

[$_, $input, $output] = $argv;
$object = in_array('--object', $argv, true);
$elf = in_array('--elf', $argv, true);

try {
    $source = file_get_contents($input);
    if ($source === false) {
        throw new RuntimeException("cannot read input: $input");
    }
    $asm = new Assembler();
    $binary = $object ? $asm->assembleObject($source)
        : ($elf ? $asm->assembleElf($source) : $asm->assemble($source));
    if (file_put_contents($output, $binary) === false) {
        throw new RuntimeException("cannot write output: $output");
    }
    printf("Wrote %d bytes to %s\n", strlen($binary), $output);
} catch (Throwable $e) {
    fwrite(STDERR, "Assembly error: " . $e->getMessage() . "\n");
    exit(1);
}
