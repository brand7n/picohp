{
    "name": "picoir/picoir",
    "description": "PHP subset compiler: JSON AST (php-parser) -> PicoIR -> LLVM IR / ARM64 assembly",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "remodulate/pico-runtime": "@dev",
        "nikic/php-parser": "^5.9.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../pico_runtime",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "PicoIR\\": "src/"
        },
        "classmap": [
            "src/Instruction/Instructions.php",
            "src/Values.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PicoIR\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
